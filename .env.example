# Campus Connect AI - Environment Configuration

# 1. Google Gemini API key used exclusively on the server-side for circular document extraction.
# NEVER prefix with NEXT_PUBLIC_ or commit actual keys.
GEMINI_API_KEY=

# 2. Authentication Secret (REQUIRED for production and development).
# Must be at least 16 characters long. Generate using: openssl rand -hex 32
AUTH_SECRET=

# 3. Persistent SQLite Database File Path (Optional, defaults to ./data/campus-connect.db)
DATABASE_PATH=

# 4. First-Administrator Provisioning Variables (Optional; can also use CLI parameters)
# Used when running: npm run create-admin
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=
ADMIN_DEPARTMENT=
